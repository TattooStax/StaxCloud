n35:     (\n36:         [\n37:             (header::CONTENT_TYPE, \"image/png\"),\n38:             (header::CACHE_CONTROL, \"public, max-age=86400, immutable\"),\n39:         ],\n40:         LOGO_PNG,\n41:     )\n42: }\n43: \n44: /// GET /favicon.ico — Serve the OpenFang favicon.\n45: pub async fn favicon_ico() -> impl IntoResponse {\n46:     (\n47:         [\n48:             (header::CONTENT_TYPE, \"image/x-icon\"),\n49:             (header::CACHE_CONTROL, \"public, max-age=86400, immutable\"),\n50:         ],\n51:         FAVICON_ICO,\n52:     )\n53: }\n54: \n55: /// Embedded PWA manifest for installable web app support.\n56: const MANIFEST_JSON: &str = include_str!(\"../static/manifest.json\");\n57: \n58: /// Embedded service worker for PWA support.\n59: const SW_JS: &str = include_str!(\"../static/sw.js\");\n60: \n61: /// GET /manifest.json — Serve the PWA web app manifest.\n62: pub async fn manifest_json() -> impl IntoResponse {\n63:     (\n64:         [\n65:             (header::CONTENT_TYPE, \"application/manifest+json\"),\n66:             (header::CACHE_CONTROL, \"public, max-age=86400, immutable\"),\n67:         ],\n68:         MANIFEST_JSON,\n69:     )\n70: }\n71: \n72: /// GET /sw.js — Serve the PWA service worker.\n73: pub async fn sw_js() -> impl IntoResponse {\n74:     (\n75:         [\n76:             (header::CONTENT_TYPE, \"application/javascript\"),\n77:             (header::CACHE_CONTROL, \"no-cache\"),\n78:         ],\n79:         SW_JS,\n80:     )\n81: }\n82: \n83: /// GET / — Serve the OpenFang Dashboard single-page application.\n84: ///\n85: /// Generates a unique CSP nonce on every request and injects it into both\n86: /// the `<script>` tags and the `Content-Security-Policy` header. This\n87: /// replaces `'unsafe-inline'` so only our own scripts execute.\n88: pub async fn webchat_page() -> impl IntoResponse {\n89:     let nonce = uuid::Uuid::new_v4().to_string();\n90:     let html = WEBCHAT_HTML.replace(NONCE_PLACEHOLDER, &nonce);\n91:     let csp = format!(\n92:         \"default-src 'self'; \\\n93:          script-src 'self' 'nonce-{nonce}' 'unsafe-eval' https://cdn.jsdelivr.net; \\\n94:          style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com https://cdn.jsdelivr.net; \\\n95:          img-src 'self' data: blob:; \\\n96:          connect-src 'self' ws://localhost:* ws://127.0.0.1:* wss://localhost:* wss://127.0.0.1:* https://cdn.jsdelivr.net; \\\n97:          font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; \\\n98:          media-src 'self' blob:; \\\n99:          frame-src 'self' blob:; \\\n100:          object-src 'none'; \\\n101:          base-uri 'self'; \\\n102:          form-action 'self'\"\n103:     );\n104:     (\n105:         [\n106:             (header::CONTENT_TYPE, \"text/html; charset=utf-8\".to_string()),\n107:             (\n108:                 header::HeaderName::from_static(\"content-security-policy\"),\n109:                 csp,\n110:             ),\n111:             (header::CACHE_CONTROL, \"no-store\".to_string()),\n112:         ],\n113:         html,\n114:     )\n115: }\n116: \n117: /// The embedded HTML/CSS/JS for the OpenFang Dashboard.\n118: ///\n119: /// Assembled at compile time from organized static files.\n120: /// All vendor libraries (Alpine.js, marked.js, highlight.js) are bundled\n121: /// locally — no CDN dependency. Alpine.js is included LAST because it\n122: /// immediately processes x-data directives and fires alpine:init on load.\n123: /// KaTeX is loaded dynamically from jsdelivr CDN when needed for LaTeX rendering.\n124: const WEBCHAT_HTML: &str = concat!(\n125:     include_str!(\"../static/index_head.html\"),\n126:     \"<style>\\n\",\n127:     include_str!(\"../static/css/theme.css\"),\n128:     \"\\n\",\n129:     include_str!(\"../static/css/layout.css\"),\n130:     \"\\n\",\n131:     include_str!(\"../static/css/components.css\"),\n132:     \"\\n\",\n133:     include_str!(\"../static/vendor/github-dark.min.css\"),\n134:     \"\\n</style>\\n\",\n135:     include_str!(\"../static/index_body.html\"),\n136:     // Vendor libs: marked + highlight first (used by app.js), then Chart.js\n137:     \"<script nonce=\\\"__NONCE__\\\">\\n\",\n138:     include_str!(\"../static/vendor/marked.min.js\"),\n139:     \"\\n</script>\\n\",\n140:     \"<script nonce=\\\"__NONCE__\\\">\\n\",\n141:     include_str!(\"../static/vendor/highlight.min.js\"),\n142:     \"\\n</script>\\n\",\n143:     \"<script nonce=\\\"__NONCE__\\\">\\n\",\n144:     include_str!(\"../static/vendor/chart.umd.min.js\"),\n145:     \"\\n</script>\\n\",\n146:     // App code\n147:     \"<script nonce=\\\"__NONCE__\\\">\\n\",\n148:     include_str!(\"../static/js/api.js\"),\n149:     \"\\n\",\n150:     include_str!(\"../static/js/app.js\"),\n151:     \"\\n\",\n152:     include_str!(\"../static/js/pages/overview.js\"),\n153:     \"\\n\",\n154:     include_str!(\"../static/js/katex.js\"),\n155:     \"\\n\",\n156:     include_str!(\"../static/js/pages/chat.js\"),\n157:     \"\\n\",\n158:     include_str!(\"../static/js/pages/agents.js\"),\n159:     \"\\n\",\n160:     include_str!(\"../static/js/pages/workflows.js\"),\n161:     \"\\n\",\n162:     include_str!(\"../static/js/pages/workflow-builder.js\"),\n163:     \"\\n\",\n164:     include_str!(\"../static/js/pages/channels.js\"),\n165:     \"\\n\",\n166:     include_str!(\"../static/js/pages/skills.js\"),\n167:     \"\\n\",\n168:     include_str!(\"../static/js/pages/hands.js\"),\n169:     \"\\n\",\n170:     include_str!(\"../static/js/pages/scheduler.js\"),\n171:     \"\\n\",\n172:     include_str!(\"../static/js/pages/settings.js\"),\n173:     \"\\n\",\n174:     include_str!(\"../static/js/pages/usage.js\"),\n175:     \"\\n\",\n176:     include_str!(\"../static/js/pages/sessions.js\"),\n177:     \"\\n\",\n178:     include_str!(\"../static/js/pages/logs.js\"),\n179:     \"\\n\",\n180:     include_str!(\"../static/js/pages/wizard.js\"),\n181:     \"\\n\",\n182:     include_str!(\"../static/js/pages/approvals.js\"),\n183:     \"\\n\",\n184:     include_str!(\"../static/js/pages/forms.js\"),\n185:     \"\\n\",\n186:     include_str!(\"../static/js/pages/contacts.js\"),\n187:     \"\\n\",\n188:     include_str!(\"../static/js/pages/sms.js\"),\n189:     \"\\n\",\n190:     include_str!(\"../static/js/pages/setup.js\"),\n191:     \"\\n\",\n192:     include_str!(\"../static/js/pages/comms.js\"),\n193:     \"\\n\",\n194:     include_str!(\"../static/js/pages/runtime.js\"),\n195:     \"\\n\",\n196:     include_str!(\"../static/js/pages/home.js\"),\n197:     \"\\n</script>\\n\",\n198:     // Alpine.js MUST be last — it processes x-data and fires alpine:init\n199:     \"<script nonce=\\\"__NONCE__\\\">\\n\",\n200:     include_str!(\"../static/vendor/alpine.min.js\"),\n201:     \"\\n</script>\\n\",\n202:     \"</body></html>\"\n203: );\n\n(End of file - total 203 lines)\n</content>","metadata":{"preview":"//! Embedded WebChat UI served as static HTML.\n//!\n//! The production dashboard is assembled at compile time from separate\n//! HTML/CSS/JS files under `static/` using `include_str!()`. This keeps\n//! single-binary deployment while allowing organized source files.\n//!\n//! Features:\n//! - Alpine.js SPA with hash-based routing (10 panels)\n//! - Dark/light theme toggle with system preference detection\n//! - Responsive layout with collapsible sidebar\n//! - Markdown rendering + syntax highlighting (bundled locally)\n//! - WebSocket real-time chat with HTTP fallback\n//! - Agent management, workflows, memory browser, audit log, and more\n\nuse axum::http::header;\nuse axum::response::IntoResponse;\n\n/// Nonce placeholder in compile-time HTML, replaced at request time.\nconst NONCE_PLACEHOLDER: &str = \"__NONCE__\";\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/shawnlowe/openfang-build/repo/crates/openfang-api/src/webchat.rs","text":"//! Embedded WebChat UI served as static HTML.\n//!\n//! The production dashboard is assembled at compile time from separate\n//! HTML/CSS/JS files under `static/` using `include_str!()`. This keeps\n//! single-binary deployment while allowing organized source files.\n//!\n//! Features:\n//! - Alpine.js SPA with hash-based routing (10 panels)\n//! - Dark/light theme toggle with system preference detection\n//! - Responsive layout with collapsible sidebar\n//! - Markdown rendering + syntax highlighting (bundled locally)\n//! - WebSocket real-time chat with HTTP fallback\n//! - Agent management, workflows, memory browser, audit log, and more\n\nuse axum::http::header;\nuse axum::response::IntoResponse;\n\n/// Nonce placeholder in compile-time HTML, replaced at request time.\nconst NONCE_PLACEHOLDER: &str = \"__NONCE__\";\n\n/// Compile-time ETag based on the crate version.\n/// Not used for the dashboard page (nonce prevents caching) but retained\n/// for potential future use by static asset handlers.\n#[allow(dead_code)]\nconst ETAG: &str = concat!(\"\\\"openfang-\", env!(\"CARGO_PKG_VERSION\"), \"\\\"\");\n\n/// Embedded logo PNG for single-binary deployment.\nconst LOGO_PNG: &[u8] = include_bytes!(\"../static/logo.png\");\n\n/// Embedded favicon ICO for browser tabs.\nconst FAVICON_ICO: &[u8] = include_bytes!(\"../static/favicon.ico\");\n\n/// GET /logo.png — Serve the OpenFang logo.\npub async fn logo_png() -> impl IntoResponse {\n    (\n        [\n            (header::CONTENT_TYPE, \"image/png\"),\n            (header::CACHE_CONTROL, \"public, max-age=86400, immutable\"),\n        ],\n        LOGO_PNG,\n    )\n}\n\n/// GET /favicon.ico — Serve the OpenFang favicon.\npub async fn favicon_ico() -> impl IntoResponse {\n    (\n        [\n            (header::CONTENT_TYPE, \"image/x-icon\"),\n            (header::CACHE_CONTROL, \"public, max-age=86400, immutable\"),\n        ],\n        FAVICON_ICO,\n    )\n}\n\n/// Embedded PWA manifest for installable web app support.\nconst MANIFEST_JSON: &str = include_str!(\"../static/manifest.json\");\n\n/// Embedded service worker for PWA support.\nconst SW_JS: &str = include_str!(\"../static/sw.js\");\n\n/// GET /manifest.json — Serve the PWA web app manifest.\npub async fn manifest_json() -> impl IntoResponse {\n    (\n        [\n            (header::CONTENT_TYPE, \"application/manifest+json\"),\n            (header::CACHE_CONTROL, \"public, max-age=86400, immutable\"),\n        ],\n        MANIFEST_JSON,\n    )\n}\n\n/// GET /sw.js — Serve the PWA service worker.\npub async fn sw_js() -> impl IntoResponse {\n    (\n        [\n            (header::CONTENT_TYPE, \"application/javascript\"),\n            (header::CACHE_CONTROL, \"no-cache\"),\n        ],\n        SW_JS,\n    )\n}\n\n/// GET / — Serve the OpenFang Dashboard single-page application.\n///\n/// Generates a unique CSP nonce on every request and injects it into both\n/// the `<script>` tags and the `Content-Security-Policy` header. This\n/// replaces `'unsafe-inline'` so only our own scripts execute.\npub async fn webchat_page() -> impl IntoResponse {\n    let nonce = uuid::Uuid::new_v4().to_string();\n    let html = WEBCHAT_HTML.replace(NONCE_PLACEHOLDER, &nonce);\n    let csp = format!(\n        \"default-src 'self'; \\\n         script-src 'self' 'nonce-{nonce}' 'unsafe-eval' https://cdn.jsdelivr.net; \\\n         style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com https://cdn.jsdelivr.net; \\\n         img-src 'self' data: blob:; \\\n         connect-src 'self' ws://localhost:* ws://127.0.0.1:* wss://localhost:* wss://127.0.0.1:* https://cdn.jsdelivr.net; \\\n         font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; \\\n         media-src 'self' blob:; \\\n         frame-src 'self' blob:; \\\n         object-src 'none'; \\\n         base-uri 'self'; \\\n         form-action 'self'\"\n    );\n    (\n        [\n            (header::CONTENT_TYPE, \"text/html; charset=utf-8\".to_string()),\n            (\n                header::HeaderName::from_