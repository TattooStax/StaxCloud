{"type":"tool_use","timestamp":1793668900041,"sessionID":"ses_e6107b5a3ffeOiP9j8PWmY0U9w","part":{"type":"tool","tool":"write","callID":"toolu_018Tk154AMaTfaSi633gyUPW","state":{"status":"completed","input":{"filePath":"/tmp/opencode/r3/cdp.mjs","content":"// CDP driver: node cdp.mjs <spec.json>\n// spec: { width, height, mobile, touch, dark, reduce, steps: [...] }\n// steps: {nav, ms} {eval} {wait} {shot} {drag:{x0,y0,x1,y1,n,ms,kind:'touch'|'mouse',shotAt,shot,hold}} {tap:{x,y,kind}}\nimport { spawn } from 'node:child_process';\nimport { readFileSync, writeFileSync, mkdtempSync } from 'node:fs';\n\nconst spec = JSON.parse(readFileSync(process.argv[2], 'utf8'));\nconst port = 9300 + Math.floor(Math.random() * 500);\nconst prof = mkdtempSync('/tmp/opencode/r3/prof-');\nconst args = ['--headless=new', '--no-sandbox', '--disable-gpu', '--hide-scrollbars', `--remote-debugging-port=${port}`, `--user-data-dir=${prof}`, `--window-size=${spec.width},${spec.height}`, 'about:blank'];\nconst chrome = spawn('google-chrome', args, { stdio: 'ignore' });\nconst sleep = (ms) => new Promise(r => setTimeout(r, ms));\nlet ws, id = 0; const pending = new Map(); const logs = [];\nasync function connect() {\n  for (let i = 0; i < 50; i++) {\n    try {\n      const list = await (await fetch(`http://127.0.0.1:${port}/json`)).json();\n      const page = list.find(t => t.type === 'page');\n      if (page) { ws = new WebSocket(page.webSocketDebuggerUrl); await new Promise(r => ws.onopen = r); return; }\n    } catch (e) {}\n    await sleep(200);\n  }\n  throw new Error('no chrome');\n}\nfunction send(method, params = {}) {\n  return new Promise((res) => { const i = ++id; pending.set(i, res); ws.send(JSON.stringify({ id: i, method, params })); });\n}\nawait connect();\nws.onmessage = (m) => {\n  const d = JSON.parse(m.data);\n  if (d.id && pending.has(d.id)) { pending.get(d.id)(d.result || d.error); pending.delete(d.id); }\n  if (d.method === 'Runtime.consoleAPICalled') logs.push(d.params.type + ': ' + d.params.args.map(a => a.value ?? a.description).join(' '));\n  if (d.method === 'Log.entryAdded') logs.push('log-' + d.params.entry.level + ': ' + d.params.entry.text + ' ' + (d.params.entry.url || ''));\n  if (d.method === 'Runtime.exceptionThrown') logs.push('EXC: ' + JSON.stringify(d.params.exceptionDetails.exception?.description || d.params.exceptionDetails.text));\n};\nawait send('Runtime.enable');\nawait send('Page.enable');\nawait send('Log.enable');\nif (spec.touch) await send('Emulation.setTouchEmulationEnabled', { enabled: true, maxTouchPoints: 5 });\nif (spec.mobile) await send('Emulation.setDeviceMetricsOverride', { width: spec.width, height: spec.height, deviceScaleFactor: 2, mobile: true });\nconst feats = [{ name: 'prefers-color-scheme', value: spec.dark ? 'dark' : 'light' }];\nif (spec.reduce) feats.push({ name: 'prefers-reduced-motion', value: 'reduce' });\nawait send('Emulation.setEmulatedMedia', { features: feats });\nasync function shot(path) { const r = await send('Page.captureScreenshot', { format: 'png' }); writeFileSync(path, Buffer.from(r.data, 'base64')); console.log('shot>', path); }\nasync function ev(expr) { const r = await send('Runtime.evaluate', { expression: expr, awaitPromise: true, returnByValue: true }); return r.result?.value ?? r.exceptionDetails?.text ?? r; }\nasync function pt(kind, phase, x, y) {\n  if (kind === 'mouse') {\n    const type = { start: 'mousePressed', move: 'mouseMoved', end: 'mouseReleased' }[phase];\n    await send('Input.dispatchMouseEvent', { type, x, y, button: 'left', buttons: phase === 'end' ? 0 : 1, clickCount: 1 });\n  } else {\n    const type = { start: 'touchStart', move: 'touchMove', end: 'touchEnd' }[phase];\n    await send('Input.dispatchTouchEvent', { type, touchPoints: phase === 'end' ? [] : [{ x, y, id: 1, radiusX: 4, radiusY: 4, force: 1 }] });\n  }\n}\nfor (const st of spec.steps) {\n  if (st.nav) { await send('Page.navigate', { url: st.nav }); await sleep(st.ms || 3000); }\n  if (st.label) console.log('--', st.label);\n  if (st.eval) console.log('eval>', JSON.stringify(await ev(st.eval)));\n  if (st.drag) {\n    const d = st.drag, n = d.n || 12, kind = d.kind || 'touch';\n    await pt(kind, 'start', d.x0, d.y0);\n    for (let i = 1; i <= n; i++) {\n      const x = d.x0 + (d.x1 - d.x0) * i / n, y = d.y0 + (d.y1 - d.y0) * i / n;\n      await pt(kind, 'move', x, y);\n      await sleep((d.ms || 400) / n);\n      if (d.shotAt === i && d.shot) { await sleep(60); console.log('mid>', JSON.stringify(await ev(d.probe || '1'))); await shot(d.shot); }\n    }\n    if (d.hold) await sleep(d.hold);\n    await pt(kind, 'end', d.x1, d.y1);\n  }\n  if (st.tap) { const k = st.tap.kind || 'touch'; await pt(k, 'start', st.tap.x, st.tap.y); await sleep(40); await pt(k, 'end', st.tap.x, st.tap.y); }\n  if (st.key) { await send('Input.dispatchKeyEvent', { type: 'keyDown', key: st.key, code: st.key, windowsVirtualKeyCode: st.vk || 27 }); await send('Input.dispatchKeyEvent', { type: 'keyUp', key: st.key, code: st.key, windowsVirtualKeyCode: st.vk || 27 }); }\n  if (st.wait) await sleep(st.wait);\n  if (st.shot) await shot(st.shot);\n}\nconsole.log('console:\\n' + logs.filter(l => !/^debug/.test(l)).slice(0, 80).join('\\n'));\nws.close(); chrome.kill();\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/tmp/opencode/r3/cdp.mjs","exists":false,"truncated":false},"title":"../../../../tmp/opencode/r3/cdp.mjs","time":{"start":1793668900028,"end":1793668900038}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"I'm extending the CDP driver to support touch and mouse gesture sequences, including a drag helper that dispatches touchStart/Move/End or mouse events, plus media emulation for reduced motion testing.\n\n","format":"anthropic-claude-v1","index":0,"signature":".eyJlbmRwb2ludF9zbHVnIjoiYW50aHJvcGljL2NsYXVkZS1vcHVzLTUuNS0yMDI2MDkyMXxjbGF1ZGUtb24tYXdzIn0"}]}},"id":"prt_19eff2bd0001yH3szeP4MCq0ju","sessionID":"ses_e6107b5a3ffeOiP9j8PWmY0U9w","messageID":"msg_19eff13e10014DGWiD0YpJrG9E"}}
