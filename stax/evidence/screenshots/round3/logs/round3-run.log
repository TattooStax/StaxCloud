].map(b=>b.textContent.trim()).join())}})()\"},\n {\"shot\":D+\"9-advanced-helpers.png\"},\n]\njson.dump({\"width\":w,\"height\":h,\"mobile\":w<600,\"dark\":dark,\"steps\":steps},open('gate-'+cfg+'.json','w'))\n----\n#!/usr/bin/env python3\n\"\"\"Preview-only proxy: serves the dashboard assembled from disk (same order as\nwebchat.rs) and forwards every other path to the staging daemon.\"\"\"\nimport http.server, re, urllib.request, sys\n\nROOT = '/home/shawnlowe/openfang-build/repo/crates/openfang-api'\nUP = 'http://127.0.0.1:4294'\nPORT = int(sys.argv[1]) if len(sys.argv) > 1 else 8765\n\ndef assemble():\n    src = open(ROOT + '/src/webchat.rs').read()\n    block = src[src.index('const WEBCHAT_HTML'):]\n    block = block[:block.index(');')]\n    out = []\n    for m in re.finditer(r'include_str!\\(\"\\.\\./([^\"]+)\"\\)|\"((?:[^\"\\\\]|\\\\.)*)\"', block):\n        if m.group(1):\n            out.append(open(ROOT + '/' + m.group(1)).read())\n        else:\n            s = m.group(2).encode().decode('unicode_escape')\n            out.append(s.replace('__NONCE__', 'dev'))\n    return ''.join(out)\n\nclass H(http.server.BaseHTTPRequestHandler):\n    def log_message(self, *a): pass\n    def _proxy(self, method):\n        if method == 'GET' and self.path.split('?')[0] in ('/', '/index.html'):\n            body = assemble().encode()\n            self.send_response(200)\n            self.send_header('content-type', 'text/html; charset=utf-8')\n            self.send_header('content-length', str(len(body)))\n            self.end_headers(); self.wfile.write(body); return\n        n = int(self.headers.get('content-length') or 0)\n        data = self.rfile.read(n) if n else None\n        req = urllib.request.Request(UP + self.path, data=data, method=method)\n        for k in ('content-type', 'authorization', 'cookie'):\n            if self.headers.get(k): req.add_header(k, self.headers[k])\n        try:\n            r = urllib.request.urlopen(req, timeout=60)\n            code, hdrs, body = r.status, r.headers, r.read()\n        except urllib.error.HTTPError as e:\ngate-home:\ndaemon.log\n\nhome-dev:\ndaemon.log\n","metadata":{"output":"// Minimal CDP driver: node cdp.mjs <script.json>\n// script: { width, height, dark, url, steps: [ {eval}, {wait}, {shot}, {click} ] }\nimport { spawn } from 'node:child_process';\nimport { readFileSync, writeFileSync, mkdtempSync } from 'node:fs';\n\nconst spec = JSON.parse(readFileSync(process.argv[2], 'utf8'));\nconst port = 9300 + Math.floor(Math.random() * 500);\nconst prof = mkdtempSync('/tmp/opencode/cdp-');\nconst args = ['--headless=new', '--no-sandbox', '--disable-gpu', '--hide-scrollbars', `--remote-debugging-port=${port}`, `--user-data-dir=${prof}`, `--window-size=${spec.width},${spec.height}`, 'about:blank'];\nif (spec.dark) args.push('--force-dark-mode');\nconst chrome = spawn('google-chrome', args, { stdio: 'ignore' });\nconst sleep = (ms) => new Promise(r => setTimeout(r, ms));\nlet ws, id = 0; const pending = new Map(); const logs = [];\nasync function connect() {\n  for (let i = 0; i < 50; i++) {\n    try {\n      const list = await (await fetch(`http://127.0.0.1:${port}/json`)).json();\n      const page = list.find(t => t.type === 'page');\n      if (page) { ws = new WebSocket(page.webSocketDebuggerUrl); await new Promise(r => ws.onopen = r); return; }\n    } catch (e) {}\n    await sleep(200);\n  }\n  throw new Error('no chrome');\n}\nfunction send(method, params = {}) {\n  return new Promise((res) => { const i = ++id; pending.set(i, res); ws.send(JSON.stringify({ id: i, method, params })); });\n}\nawait connect();\nws.onmessage = (m) => {\n  const d = JSON.parse(m.data);\n  if (d.id && pending.has(d.id)) { pending.get(d.id)(d.result || d.error); pending.delete(d.id); }\n  if (d.method === 'Runtime.consoleAPICalled') logs.push(d.params.type + ': ' + d.params.args.map(a => a.value ?? a.description).join(' '));\n  if (d.method === 'Log.entryAdded') logs.push('log-' + d.params.entry.level 