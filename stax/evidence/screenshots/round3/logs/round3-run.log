method === 'Runtime.consoleAPICalled') logs.push(d.params.type + ': ' + d.params.args.map(a => a.value ?? a.description).join(' '));\n  if (d.method === 'Log.entryAdded') logs.push('log-' + d.params.entry.level + ': ' + d.params.entry.text + ' ' + (d.params.entry.url || ''));\n  if (d.method === 'Runtime.exceptionThrown') logs.push('EXC: ' + JSON.stringify(d.params.exceptionDetails.exception?.description || d.params.exceptionDetails.text));\n};\nawait send('Runtime.enable');\nawait send('Page.enable');\nawait send('Log.enable');\nif (spec.touch) await send('Emulation.setTouchEmulationEnabled', { enabled: true });\nif (spec.mobile) await send('Emulation.setDeviceMetricsOverride', { width: spec.width, height: spec.height, deviceScaleFactor: 2, mobile: true });\nfor (const st of spec.steps) {\n  if (st.nav) { await send('Page.navigate', { url: st.nav }); await sleep(st.ms || 3000); }\n  if (st.eval) { const r = await send('Runtime.evaluate', { expression: st.eval, awaitPromise: true, returnByValue: true }); console.log('eval>', JSON.stringify(r.result?.value ?? r.exceptionDetails?.text ?? r)); }\n  if (st.wait) await sleep(st.wait);\n  if (st.shot) { const r = await send('Page.captureScreenshot', { format: 'png', captureBeyondViewport: false }); writeFileSync(st.shot, Buffer.from(r.data, 'base64')); console.log('shot>', st.shot); }\n}\nif (logs.length) console.log('console:\\n' + logs.filter(l => !/^debug/.test(l)).slice(0, 80).join('\\n'));\nws.close(); chrome.kill();\n-----\nimport json,sys\ncfg=sys.argv[1]  # phone-light etc\nbase='http://127.0.0.1:4296'\nw,h=(390,844) if cfg.startswith('phone') else (1440,900)\ndark=cfg.endswith('dark')\nD='/home/shawnlowe/openfang-build/corrections2-shots/'+cfg+'-'\nVOC=r\"provider|model|api[ _-]?key|\\bkey\\b|token|\\benv\\b|environment|config|kernel|agent|daemon|\\bllm\\b|\\bhand\\b|hands|uuid|openfang|sidecar|websocket|adapter|webhook|secret|anthropic|openai|gemini|groq|ollama|[A-Z]{2,}_[A-Z_]{2,}|[0-9a-f]{8}-[0-9a-f]{4}|\\b[0-9a-f]{12,}\\b\"\ndef scan(label):\n    return \"(()=>{const vis=e=>e&&e.offsetParent!==null;const pg=[...document.querySelectorAll('.sys-page')].find(vis);const txt=pg?pg.innerText:'(no page)';const re=new RegExp(%s,'gi');const chips=[...document.querySelectorAll('.stax-chips .stax-chip')].filter(vis).map(c=>c.textContent.trim());const docks=[...document.querySelectorAll('.stax-dock')].filter(vis).map(d=>d.getAttribute('aria-label')+': '+[...d.querySelectorAll('.stax-dock-btn')].map(b=>b.textContent.trim()+(b.classList.contains('active')?'*':'')).join(' | '));return {label:%s,hash:location.hash,theme:document.body.dataset.theme,lines:txt.split('\\\\n').map(s=>s.trim()).filter(Boolean),vocabHits:txt.match(re)||[],chipWall:chips,docks}})()\"%(json.dumps(VOC),json.dumps(label))\ndef go(hsh): return \"(()=>{location.hash=%s;return location.hash})()\"%json.dumps(hsh)\nOPEN=\"(()=>{[...document.querySelectorAll('.stax-menu-btn')].find(b=>b.offsetParent)?.click();return 1})()\"\nDRAWER=\"\"\"(()=>{const side=document.querySelector('.stax-side');const body=side.querySelector('.sd-body');return {open:side.classList.contains('open'),sections:[...side.querySelectorAll('.sd-sec-head')].map(h=>({name:h.textContent.trim(),expanded:h.getAttribute('aria-expanded'),ico:h.querySelector('use').getAttribute('href')})),chips:side.querySelectorAll('.sd-chip,[data-tile]').length,tilesStrip:side.querySelectorAll('.sd-tiles,.sd-tile,[aria-label=Shortcuts]').length,ownerInScroll:body.contains(side.querySelector('#sd-owner')),ownerLast:body.lastElementChild.classList.contains('sd-owner'),pinned:[...side.querySelectorAll('*')].filter(e=>/fixed|sticky/.test(getComputedStyle(e).position)).length}})()\"\"\"\nEXP=\"(async()=>{for(const h of document.querySelectorAll('.sd-sec-head')){h.click();await new Promise(r=>setTimeout(r,150))}const side=document.querySelector('.stax-side');return [...side.querySelectorAll('.sd-sec-rows .sd-row')].map(r=>{const s=r.querySelector('svg');const cs=getComputedSty