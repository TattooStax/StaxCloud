{"type":"tool_use","timestamp":1793668527799,"sessionID":"ses_e6107b5a3ffeOiP9j8PWmY0U9w","part":{"type":"tool","tool":"read","callID":"toolu_017M5m9rmp32XE6n7m9dLZ69","state":{"status":"completed","input":{"filePath":"/home/shawnlowe/openfang-build/repo/crates/openfang-api/static/css/layout.css","limit":370},"output":"<path>/home/shawnlowe/openfang-build/repo/crates/openfang-api/static/css/layout.css</path>\n<type>file</type>\n<content>\n1: /* OpenFang Layout — Grid + Sidebar + Responsive */\n2: \n3: /* Firefox compat: hide x-cloak elements until Alpine.js initializes.\n4:    Without this, the sidebar flashes hidden in Firefox while Alpine\n5:    processes the nested x-data scopes for nav sections. */\n6: [x-cloak] { display: none !important; }\n7: \n8: .app-layout {\n9:   display: flex;\n10:   height: 100vh;\n11:   overflow: hidden;\n12: }\n13: \n14: /* Sidebar */\n15: .sidebar {\n16:   width: var(--sidebar-width);\n17:   background: var(--bg-primary);\n18:   border-right: 1px solid var(--border);\n19:   display: flex;\n20:   flex-direction: column;\n21:   flex-shrink: 0;\n22:   transition: width var(--transition-normal);\n23:   z-index: 100;\n24: }\n25: \n26: .sidebar.collapsed {\n27:   width: var(--sidebar-collapsed);\n28: }\n29: \n30: .sidebar.collapsed .sidebar-label,\n31: .sidebar.collapsed .sidebar-header-text,\n32: .sidebar.collapsed .nav-label { display: none; }\n33: \n34: .sidebar.collapsed .nav-item { justify-content: center; padding: 12px 0; }\n35: \n36: .sidebar-header {\n37:   padding: 16px;\n38:   border-bottom: 1px solid var(--border);\n39:   display: flex;\n40:   align-items: center;\n41:   justify-content: space-between;\n42:   min-height: 60px;\n43: }\n44: \n45: .sidebar-logo {\n46:   display: flex;\n47:   align-items: center;\n48:   gap: 10px;\n49: }\n50: \n51: .sidebar-logo img {\n52:   width: 28px;\n53:   height: 28px;\n54:   opacity: 0.8;\n55:   transition: opacity 0.2s, transform 0.2s;\n56: }\n57: \n58: .sidebar-logo img:hover {\n59:   opacity: 1;\n60:   transform: scale(1.05);\n61: }\n62: \n63: [data-theme=\"light\"] .sidebar-logo img,\n64: [data-theme=\"light\"] .message-avatar img {\n65:   filter: invert(1);\n66: }\n67: \n68: .sidebar-header h1 {\n69:   font-size: 14px;\n70:   font-weight: 700;\n71:   color: var(--accent);\n72:   letter-spacing: 3px;\n73:   font-family: var(--font-mono);\n74: }\n75: \n76: .sidebar-header .version {\n77:   font-size: 9px;\n78:   color: var(--text-muted);\n79:   margin-top: 1px;\n80:   letter-spacing: 0.5px;\n81: }\n82: \n83: .sidebar-status {\n84:   font-size: 11px;\n85:   color: var(--success);\n86:   display: flex;\n87:   align-items: center;\n88:   gap: 6px;\n89:   padding: 8px 16px;\n90:   border-bottom: 1px solid var(--border);\n91: }\n92: \n93: .sidebar-status.offline { color: var(--error); }\n94: \n95: .status-dot {\n96:   width: 6px; height: 6px;\n97:   border-radius: 50%;\n98:   background: currentColor;\n99:   flex-shrink: 0;\n100:   box-shadow: 0 0 6px currentColor;\n101: }\n102: \n103: .conn-badge {\n104:   font-size: 9px;\n105:   padding: 1px 5px;\n106:   border-radius: 3px;\n107:   font-weight: 600;\n108:   letter-spacing: 0.5px;\n109:   margin-left: auto;\n110: }\n111: .conn-badge.ws { background: var(--success); color: #000; }\n112: .conn-badge.http { background: var(--warning); color: #000; }\n113: \n114: /* Navigation */\n115: .sidebar-nav {\n116:   flex: 1;\n117:   overflow-y: auto;\n118:   padding: 8px;\n119:   scrollbar-width: none;\n120: }\n121: .sidebar-nav::-webkit-scrollbar { width: 0; }\n122: \n123: .nav-section {\n124:   margin-bottom: 4px;\n125: }\n126: \n127: .nav-section-title {\n128:   font-size: 12px;\n129:   text-transform: uppercase;\n130:   letter-spacing: 1.5px;\n131:   color: var(--text-muted);\n132:   padding: 12px 12px 6px 3px;\n133:   font-weight: 600;\n134: }\n135: \n136: .sidebar.collapsed .nav-section-title { display: none; }\n137: \n138: .nav-item {\n139:   display: flex;\n140:   align-items: center;\n141:   gap: 10px;\n142:   min-height: 44px;\n143:   padding: 10px 12px;\n144:   border-radius: var(--radius-md);\n145:   cursor: pointer;\n146:   font-size: 13px;\n147:   color: var(--text-dim);\n148:   transition: all var(--transition-fast);\n149:   text-decoration: none;\n150:   border: 1px solid transparent;\n151:   white-space: nowrap;\n152:   font-weight: 500;\n153: }\n154: \n155: .nav-item:hover {\n156:   background: var(--surface2);\n157:   color: var(--text);\n158:   transform: translateX(2px);\n159: }\n160: \n161: .nav-item.active {\n162:   background: var(--accent);\n163:   color: var(--text-on-accent);\n164:   font-weight: 600;\n165:   box-shadow: var(--shadow-sm), 0 2px 8px rgba(20, 110, 104, 0.2);\n166: }\n167: \n168: .nav-icon {\n169:   width: 18px;\n170:   height: 18px;\n171:   display: inline-flex;\n172:   align-items: center;\n173:   justify-content: center;\n174:   flex-shrink: 0;\n175: }\n176: \n177: .nav-icon svg {\n178:   width: 16px;\n179:   height: 16px;\n180:   fill: none;\n181:   stroke: currentColor;\n182:   stroke-width: 2;\n183:   stroke-linecap: round;\n184:   stroke-linejoin: round;\n185: }\n186: \n187: /* Sidebar toggle button */\n188: .sidebar-toggle {\n189:   padding: 10px 16px;\n190:   border-top: 1px solid var(--border);\n191:   cursor: pointer;\n192:   text-align: center;\n193:   font-size: 14px;\n194:   color: var(--text-muted);\n195:   transition: color var(--transition-fast);\n196: }\n197: \n198: .sidebar-toggle:hover { color: var(--text); }\n199: \n200: /* Main content area */\n201: .main-content {\n202:   flex: 1;\n203:   display: flex;\n204:   flex-direction: column;\n205:   min-width: 0;\n206:   overflow: hidden;\n207:   background: var(--bg);\n208: }\n209: \n210: /* Page wrapper divs (rendered by x-if) must fill the column\n211:    and be flex containers so .page-body can scroll. */\n212: .main-content > div {\n213:   display: flex;\n214:   flex-direction: column;\n215:   flex: 1;\n216:   min-height: 0;\n217:   overflow: hidden;\n218: }\n219: \n220: .page-header {\n221:   padding: 14px 24px;\n222:   border-bottom: 1px solid var(--border);\n223:   background: var(--bg-primary);\n224:   display: flex;\n225:   align-items: center;\n226:   justify-content: space-between;\n227:   min-height: var(--header-height);\n228: }\n229: \n230: .page-header h2 {\n231:   font-size: 15px;\n232:   font-weight: 600;\n233:   letter-spacing: -0.01em;\n234: }\n235: \n236: .page-body {\n237:   flex: 1;\n238:   min-height: 0;\n239:   overflow-y: auto;\n240:   padding: 24px;\n241: }\n242: \n243: /* Mobile overlay */\n244: .sidebar-overlay {\n245:   display: none;\n246:   position: fixed;\n247:   inset: 0;\n248:   background: rgba(0,0,0,0.6);\n249:   z-index: 99;\n250: }\n251: \n252: .mobile-menu-btn {\n253:   position: fixed !important;\n254:   top: 12px;\n255:   left: 16px;\n256:   z-index: 98;\n257:   padding: 6px 10px !important;\n258: }\n259: \n260: /* Wide desktop — larger card grids */\n261: @media (min-width: 1400px) {\n262:   .card-grid { grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }\n263: }\n264: \n265: /* Responsive — tablet breakpoint */\n266: @media (max-width: 1024px) {\n267:   .card-grid { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }\n268:   .security-grid { grid-template-columns: 1fr; }\n269:   .cost-charts-row { grid-template-columns: 1fr; }\n270:   .overview-grid { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }\n271:   .page-body { padding: 16px; }\n272: }\n273: \n274: /* Responsive — mobile breakpoint */\n275: @media (max-width: 768px) {\n276:   .sidebar {\n277:     position: fixed;\n278:     left: -300px;\n279:     top: 0;\n280:     bottom: 0;\n281:     transition: left var(--transition-normal);\n282:   }\n283:   .sidebar.mobile-open {\n284:     left: 0;\n285:   }\n286:   .sidebar.mobile-open + .sidebar-overlay {\n287:     display: block;\n288:   }\n289:   .sidebar.collapsed {\n290:     width: var(--sidebar-width);\n291:     left: -300px;\n292:   }\n293:   .mobile-menu-btn { display: flex !important; }\n294:   /* Offset header content so it does not overlap the fixed mobile menu button. */\n295:   .page-header > :first-child { margin-left: 52px; }\n296: }\n297: \n298: @media (min-width: 769px) {\n299:   .mobile-menu-btn { display: none !important; }\n300: }\n301: \n302: /* Mobile small screen */\n303: @media (max-width: 480px) {\n304:   .page-header {\n305:     gap: 8px;\n306:     padding: 12px 16px;\n307:     flex-wrap: wrap;\n308:   }\n309:   .page-header h2 {\n310:     line-height: 44px;\n311:   }\n312:   .page-body { padding: 12px; }\n313:   .stats-row { flex-wrap: wrap; }\n314:   .stat-card { min-width: 80px; flex: 1 1 40%; }\n315:   .stat-card-lg { min-width: 80px; flex: 1 1 40%; padding: 12px; }\n316:   .stat-card-lg .stat-value { font-size: 22px; }\n317:   .card-grid { grid-template-columns: 1fr; }\n318:   .overview-grid { grid-template-columns: 1fr; }\n319:   .input-area { padding: 8px 12px; }\n320:   .main-content { padding: 0; }\n321:   .table-wrap { font-size: 10px; }\n322:   .modal { margin: 8px; max-height: calc(100vh - 16px); }\n323: }\n324: \n325: /* Touch-friendly tap targets */\n326: @media (pointer: coarse) {\n327:   .btn { min-height: 44px; min-width: 44px; }\n328:   .nav-item { min-height: 44px; }\n329:   .form-input, .form-select, .form-textarea { min-height: 44px; }\n330:   .toggle { min-width: 44px; min-height: 28px; }\n331: }\n332: \n333: /* Focus mode — hide sidebar for distraction-free chat */\n334: .app-layout.focus-mode .sidebar { display: none; }\n335: .app-layout.focus-mode .sidebar-overlay { display: none; }\n336: .app-layout.focus-mode .main-content { max-width: 100%; margin-left: 0; }\n337: .app-layout.focus-mode .mobile-menu-btn { display: none !important; }\n338: \n339: /* ── Icon family tokens (the one sprite in index_body.html) ──────────\n340:    Flash palette: an ink line, a paper light, and our hues as fills.\n341:    Custom properties inherit into <use> clones, so each theme sets its\n342:    own ink: dark ink on light, a cream line on dark. */\n343: :root, [data-theme=\"light\"] {\n344:   --ic-ink: #221f1b; --ic-paper: #fbf4e3;\n345:   --ic-teal: #3a9a8f; --ic-blue: #5d88b0; --ic-pink: #c27a8f; --ic-crimson: #b04a5c;\n346:   --ic-slate: #7a8797; --ic-gold: #e3ac45; --ic-gold-deep: #c48a2c;\n347: }\n348: [data-theme=\"dark\"] {\n349:   --ic-ink: #efe6d3; --ic-paper: #2a2520;\n350:   --ic-teal: #4fb3a6; --ic-blue: #6f9bc4; --ic-pink: #cf8aa0; --ic-crimson: #c95f71;\n351:   --ic-slate: #8996a8; --ic-gold: #e6b552; --ic-gold-deep: #c99436;\n352: }\n353: .stax-ic { display: block; flex: none; }\n354: \n355: /* ── R1: StaxCloud dock shell ─────────────────────────── */\n356: .app-layout { flex-direction: column; }\n357: .sidebar, .sidebar-overlay { display: none !important; }\n358: .mobile-menu-btn { display: none !important; }\n359: .stax-dock { flex: none; display: flex; background: var(--bg-primary); border-top: 1px solid var(--border); padding-bottom: env(safe-area-inset-bottom); z-index: 60; }\n360: .stax-dock-btn { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; min-height: 58px; padding: 6px 2px; background: none; border: none; color: var(--text-dim); font: inherit; font-size: 10.5px; font-weight: 600; letter-spacing: .01em; cursor: pointer; position: relative; }\n361: .stax-dock-btn svg { width: 22px; height: 22px; }\n362: .stax-dock-btn.active { color: var(--accent); }\n363: /* Primary dock: the colorful family marks. The active tab gets a tinted\n364:    pill behind its mark; the padding is always there so nothing shifts. */\n365: .stax-dock-btn .stax-ic { width: 26px; height: 26px; padding: 3px 15px; box-sizing: content-box; border-radius: 999px; transition: background-color 0.2s cubic-bezier(0.22, 1, 0.36, 1); }\n366: .stax-dock-btn.active .stax-ic { background: var(--accent-glow); }\n367: .stax-dock-btn.active span:last-child { font-weight: 700; }\n368: .stax-dock-btn:active .stax-ic { transform: scale(0.94); }\n369: .stax-dock-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: -4px; border-radius: 12px; }\n370: .stax-dock-badge { position: absolute; top: 5px; right: calc(50% - 21px); min-width: 17px; height: 17px; padding: 0 4px; border-radius: 999px; background: var(--accent); color: #fff; font-size: 10px; font-weight: 700; display: flex; align-items: center; justify-content: center; }\n\n(Showing lines 1-370 of 681. Use offset=371 to continue.)\n</content>","metadata":{"preview":"/* OpenFang Layout — Grid + Sidebar + Responsive */\n\n/* Firefox compat: hide x-cloak elements until Alpine.js initializes.\n   Without this, the sidebar flashes hidden in Firefox while Alpine\n   processes the nested x-data scopes for nav sections. */\n[x-cloak] { display: none !important; }\n\n.app-layout {\n  display: flex;\n  height: 100vh;\n  overflow: hidden;\n}\n\n/* Sidebar */\n.sidebar {\n  width: var(--sidebar-width);\n  background: var(--bg-primary);\n  border-right: 1px solid var(--border);\n  display: flex;\n  flex-direction: column;","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/shawnlowe/openfang-build/repo/crates/openfang-api/static/css/layout.css","text":"/* OpenFang Layout — Grid + Sidebar + Responsive */\n\n/* Firefox compat: hide x-cloak elements until Alpine.js initializes.\n   Without this, the sidebar flashes hidden in Firefox while Alpine\n   processes the nested x-data scopes for nav sections. */\n[x-cloak] { display: none !important; }\n\n.app-layout {\n  display: flex;\n  height: 100vh;\n  overflow: hidden;\n}\n\n/* Sidebar */\n.sidebar {\n  width: var(--sidebar-width);\n  background: var(--bg-primary);\n  border-right: 1px solid var(--border);\n  display: flex;\n  flex-direction: column;\n  flex-shrink: 0;\n  transition: width var(--transition-normal);\n  z-index: 100;\n}\n\n.sidebar.collapsed {\n  width: var(--sidebar-collapsed);\n}\n\n.sidebar.collapsed .sidebar-label,\n.sidebar.collapsed .sidebar-header-text,\n.sidebar.collapsed .nav-label { display: none; }\n\n.sidebar.collapsed .nav-item { justify-content: center; padding: 12px 0; }\n\n.sidebar-header {\n  padding: 16px;\n  border-bottom: 1px solid var(--border);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  min-height: 60px;\n}\n\n.sidebar-logo {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.sidebar-logo img {\n  width: 28px;\n  height: 28px;\n  opacity: 0.8;\n  transition: opacity 0.2s, transform 0.2s;\n}\n\n.sidebar-logo img:hover {\n  opacity: 1;\n  transform: scale(1.05);\n}\n\n[data-theme=\"light\"] .sidebar-logo img,\n[data-theme=\"light\"] .message-avatar img {\n  filter: invert(1);\n}\n\n.sidebar-header h1 {\n  font-size: 14px;\n  font-weight: 700;\n  color: var(--accent);\n  letter-spacing: 3px;\n  font-family: var(--font-mono);\n}\n\n.sidebar-header .version {\n  font-size: 9px;\n  color: var(--text-muted);\n  margin-top: 1px;\n  letter-spacing: 0.5px;\n}\n\n.sidebar-status {\n  font-size: 11px;\n  color: var(--success);\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 8px 16px;\n  border-bottom: 1px solid var(--border);\n}\n\n.sidebar-status.offline { color: var(--error); }\n\n.status-dot {\n  width: 6px; height: 6px;\n  border-radius: 50%;\n  background: currentColor;\n  flex-shrink: 0;\n  box-shadow: 0 0 6px currentColor;\n}\n\n.conn-badge {\n  font-size: 9px;\n  padding: 1px 5px;\n  border-radius: 3px;\n  font-weight: 600;\n  letter-spacing: 0.5px;\n  margin-left: auto;\n}\n.conn-badge.ws { background: var(--success); color: #000; }\n.conn-badge.http { background: var(--warning); color: #000; }\n\n/* Navigation */\n.sidebar-nav {\n  flex: 1;\n  overflow-y: auto;\n  padding: 8px;\n  scrollbar-width: none;\n}\n.sidebar-nav::-webkit-scrollbar { width: 0; }\n\n.nav-section {\n  margin-bottom: 4px;\n}\n\n.nav-section-title {\n  font-size: 12px;\n  text-transform: uppercase;\n  letter-spacing: 1.5px;\n  color: var(--text-muted);\n  padding: 12px 12px 6px 3px;\n  font-weight: 600;\n}\n\n.sidebar.collapsed .nav-section-title { display: none; }\n\n.nav-item {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  min-height: 44px;\n  padding: 10px 12px;\n  border-radius: var(--radius-md);\n  cursor: pointer;\n  font-size: 13px;\n  color: var(--text-dim);\n  transition: all var(--transition-fast);\n  text-decoration: none;\n  border: 1px solid transparent;\n  white-space: nowrap;\n  font-weight: 500;\n}\n\n.nav-item:hover {\n  background: var(--surface2);\n  color: var(--text);\n  transform: translateX(2px);\n}\n\n.nav-item.active {\n  background: var(--accent);\n  color: var(--text-on-accent);\n  font-weight: 600;\n  box-shadow: var(--shadow-sm), 0 2px 8px rgba(20, 110, 104, 0.2);\n}\n\n.nav-icon {\n  width: 18px;\n  height: 18px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.nav-icon svg {\n  width: 16px;\n  height: 16px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n/* Sidebar toggle button */\n.sidebar-toggle {\n  padding: 10px 16px;\n  border-top: 1px solid var(--border);\n  cursor: pointer;\n  text-align: center;\n  font-size: 14px;\n  color: var(--text-muted);\n  transition: color var(--transition-fast);\n}\n\n.sidebar-toggle:hover { color: var(--text); }\n\n/* Main content area */\n.main-content {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  overflow: hidden;\n  background: var(--bg);\n}\n\n/* Page wrapper divs (rendered by x-if) must fill the column\n   and be flex containers so .page-body can scroll. */\n.main-content > div {\n  display: flex;\n  flex-direction: column;\n  flex: 1;\n  min-height: 0;\n  overflow: hidden;\n}\n\n.page-header {\n  padding: 14px 24px;\n  border-bottom: 1px solid var(--border);\n  background: var(--bg-primary);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  min-height: var(--header-height);\n}\n\n.page-header h2 {\n  font-size: 15px;\n  font-weight: 600;\n  letter-spacing: -0.01em;\n}\n\n.page-body {\n  flex: 1;\n  min-height: 0;\n  overflow-y: auto;\n  padding: 24px;\n}\n\n/* Mobile overlay */\n.sidebar-overlay {\n  display: none;\n  position: fixed;\n  inset: 0;\n  background: rgba(0,0,0,0.6);\n  z-index: 99;\n}\n\n.mobile-menu-btn {\n  position: fixed !important;\n  top: 12px;\n  left: 16px;\n  z-index: 98;\n  padding: 6px 10px !important;\n}\n\n/* Wide desktop — larger card grids */\n@media (min-width: 1400px) {\n  .card-grid { grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }\n}\n\n/* Responsive — tablet breakpoint */\n@media (max-width: 1024px) {\n  .card-grid { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }\n  .security-grid { grid-template-columns: 1fr; }\n  .cost-charts-row { grid-template-columns: 1fr; }\n  .overview-grid { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }\n  .page-body { padding: 16px; }\n}\n\n/* Responsive — mobile breakpoint */\n@media (max-width: 768px) {\n  .sidebar {\n    position: fixed;\n    left: -300px;\n    top: 0;\n    bottom: 0;\n    transition: left var(--transition-normal);\n  }\n  .sidebar.mobile-open {\n    left: 0;\n  }\n  .sidebar.mobile-open + .sidebar-overlay {\n    display: block;\n  }\n  .sidebar.collapsed {\n    width: var(--sidebar-width);\n    left: -300px;\n  }\n  .mobile-menu-btn { display: flex !important; }\n  /* Offset header content so it does not overlap the fixed mobile menu button. */\n  .page-header > :first-child { margin-left: 52px; }\n}\n\n@media (min-width: 769px) {\n  .mobile-menu-btn { display: none !important; }\n}\n\n/* Mobile small screen */\n@media (max-width: 480px) {\n  .page-header {\n    gap: 8px;\n    padding: 12px 16px;\n    flex-wrap: wrap;\n  }\n  .page-header h2 {\n    line-height: 44px;\n  }\n  .page-body { padding: 12px; }\n  .stats-row { flex-wrap: wrap; }\n  .stat-card { min-width: 80px; flex: 1 1 40%; }\n  .stat-card-lg { min-width: 80px; flex: 1 1 40%; padding: 12px; }\n  .stat-card-lg .stat-value { font-size: 22px; }\n  .card-grid { grid-template-columns: 1fr; }\n  .overview-grid { grid-template-columns: 1fr; }\n  .input-area { padding: 8px 12px; }\n  .main-content { padding: 0; }\n  .table-wrap { font-size: 10px; }\n  .modal { margin: 8px; max-height: calc(100vh - 16px); }\n}\n\n/* Touch-friendly tap targets */\n@media (pointer: coarse) {\n  .btn { min-height: 44px; min-width: 44px; }\n  .nav-item { min-height: 44px; }\n  .form-input, .form-select, .form-textarea { min-height: 44px; }\n  .toggle { min-width: 44px; min-height: 28px; }\n}\n\n/* Focus mode — hide sidebar for distraction-free chat */\n.app-layout.focus-mode .sidebar { display: none; }\n.app-layout.focus-mode .sidebar-overlay { display: none; }\n.app-layout.focus-mode .main-content { max-width: 100%; margin-left: 0; }\n.app-layout.focus-mode .mobile-menu-btn { display: none !important; }\n\n/* ── Icon family tokens (the one sprite in index_body.html) ──────────\n   Flash palette: an ink line, a paper light, and our hues as fills.\n   Custom properties inherit into <use> clones, so each theme sets its\n   own ink: dark ink on light, a cream line on dark. */\n:root, [data-theme=\"light\"] {\n  --ic-ink: #221f1b; --ic-paper: #fbf4e3;\n  --ic-teal: #3a9a8f; --ic-blue: #5d88b0; --ic-pink: #c27a8f; --ic-crimson: #b04a5c;\n  --ic-slate: #7a8797; --ic-gold: #e3ac45; --ic-gold-deep: #c48a2c;\n}\n[data-theme=\"dark\"] {\n  --ic-ink: #efe6d3; --ic-paper: #2a2520;\n  --ic-teal: #4fb3a6; --ic-blue: #6f9bc4; --ic-pink: #cf8aa0; --ic-crimson: #c95f71;\n  --ic-slate: #8996a8; --ic-gold: #e6b552; --ic-gold-deep: #c99436;\n}\n.stax-ic { display: block; flex: none; }\n\n/* ── R1: StaxCloud dock shell ─────────────────────────── */\n.app-layout { flex-direction: column; }\n.sidebar, .sidebar-overlay { display: none !important; }\n.mobile-menu-btn { display: none !important; }\n.stax-dock { flex: none; display: flex; background: var(--bg-primary); border-top: 1px solid var(--border); padding-bottom: env(safe-area-inset-bottom); z-index: 60; }\n.stax-dock-btn { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; min-height: 58px; padding: 6px 2px; background: none; border: none; color: var(--text-dim); font: inherit; font-size: 10.5px; font-weight: 600; letter-spacing: .01em; cursor: pointer; position: relative; }\n.stax-dock-btn svg { width: 22px; height: 22px; }\n.stax-dock-btn.active { color: var(--accent); }\n/* Primary dock: the colorful family marks. The active tab gets a tinted\n   pill behind its mark; the padding is always there so nothing shifts. */\n.stax-dock-btn .stax-ic { width: 26px; height: 26px; padding: 3px 15px; box-sizing: content-box; border-radius: 999px; transition: background-color 0.2s cubic-bezier(0.22, 1, 0.36, 1); }\n.stax-dock-btn.active .stax-ic { background: var(--accent-glow); }\n.stax-dock-btn.active span:last-child { font-weight: 700; }\n.stax-dock-btn:active .stax-ic { transform: scale(0.94); }\n.stax-dock-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: -4px; border-radius: 12px; }\n.stax-dock-badge { position: absolute; top: 5px; right: calc(50% - 21px); min-width: 17px; height: 17px; padding: 0 4px; border-radius: 999px; background: var(--accent); color: #fff; font-size: 10px; font-weight: 700; display: flex; align-items: center; justify-content: center; }","lineStart":1,"lineEnd":370,"totalLines":681,"truncated":true}},"title":"crates/openfang-api/static/css/layout.css","time":{"start":1793668527784,"end":1793668527794}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_19ef9b446001BbLdLfQ62pl92Y","sessionID":"ses_e6107b5a3ffeOiP9j8PWmY0U9w","messageID":"msg_19ef9a697001O0kAIj56tWaA6D"}}
